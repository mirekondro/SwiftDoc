<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="dk.easv.swiftdoc.controller.ProfileManagementController"
      spacing="14.0" styleClass="app-body">

    <!-- Left: table + action buttons -->
    <VBox spacing="10.0" prefWidth="520.0" styleClass="panel">
        <Label text="Scanning profiles" styleClass="section-title"/>
        <TableView fx:id="profilesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName"      text="Profile Name"        prefWidth="180"/>
                <TableColumn fx:id="colClient"    text="Client"              prefWidth="130"/>
                <TableColumn fx:id="colDupDetect" text="Duplicate Detection" prefWidth="140"/>
                <TableColumn fx:id="colStatus"    text="Status"              prefWidth="90"/>
            </columns>
        </TableView>
        <HBox spacing="8.0">
            <Button text="Create" onAction="#onCreateClicked" styleClass="btn btn-primary">
                <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
            </Button>
            <Button text="Edit" onAction="#onEditClicked" styleClass="btn">
                <graphic><FontIcon iconLiteral="fas-pen"/></graphic>
            </Button>
            <Button fx:id="disableButton" text="Disable" onAction="#onDisableClicked" styleClass="btn">
                <graphic><FontIcon iconLiteral="fas-ban"/></graphic>
            </Button>
        </HBox>
    </VBox>

    <!-- Right: create / edit form -->
    <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="panel">
        <Label fx:id="formTitleLabel" text="Select a profile or click Create" styleClass="section-title"/>

        <Label text="Profile Name"/>
        <TextField fx:id="nameField" promptText="e.g. Standard municipal box"/>

        <Label text="Client"/>
        <ComboBox fx:id="clientCombo" maxWidth="1.7976931348623157E308"/>

        <CheckBox fx:id="dupDetectCheck" text="Enable duplicate detection"/>

        <HBox spacing="8.0">
            <Button text="Save" onAction="#onSaveClicked" styleClass="btn btn-primary">
                <graphic><FontIcon iconLiteral="fas-save"/></graphic>
            </Button>
            <Button text="Cancel" onAction="#onCancelClicked" styleClass="btn"/>
        </HBox>

        <Label fx:id="messageLabel" text="" wrapText="true"/>
    </VBox>

</HBox>
