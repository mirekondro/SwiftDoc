<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="dk.easv.swiftdoc.controller.LogsController"
            fitToWidth="true" fitToHeight="true" styleClass="workspace-scroll">
    <VBox spacing="32.0" styleClass="workspace-body">

    <VBox spacing="20.0" VBox.vgrow="ALWAYS" styleClass="viewer-container" style="-fx-padding: 32;">
        <HBox spacing="16.0" alignment="CENTER_LEFT">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="System Activity Logs" styleClass="sidebar-section-title" style="-fx-text-fill: #0F172A; -fx-padding: 0; -fx-font-size: 20px;"/>
                <Label text="Audit trail for all file and document operations" style="-fx-text-fill: #64748B;"/>
            </VBox>
            <Button text="Refresh Logs" onAction="#onRefresh" styleClass="btn btn-primary">
                <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="14"/></graphic>
            </Button>
        </HBox>

        <TableView fx:id="logsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="timestampCol" text="Timestamp" prefWidth="200"/>
                <TableColumn fx:id="userCol"      text="User"      prefWidth="160"/>
                <TableColumn fx:id="actionCol"    text="Operation" prefWidth="200"/>
                <TableColumn fx:id="fileIdCol"    text="File ID"   prefWidth="120"/>
                <TableColumn fx:id="documentCol"  text="Doc ID"    prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
</ScrollPane>
