<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane fx:id="dialogPane" styleClass="dialog-root" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.swiftdoc.controller.NewScanDialogController">
    <headerText>New Scanning Session</headerText>
    <contentText>Configure the active box and profile before starting.</contentText>

    <content>
        <VBox spacing="24.0" styleClass="dialog-content" style="-fx-padding: 32;">
            <!-- Profile Selection -->
            <VBox spacing="12.0">
                <Label style="-fx-font-weight: 700;" text="Scanning Profile" />
                <HBox spacing="20.0">
                    <ComboBox fx:id="profileComboBox" maxWidth="Infinity" promptText="Select a profile..." HBox.hgrow="ALWAYS" />
                    <VBox prefWidth="300.0" spacing="8.0" styleClass="stat-card" style="-fx-padding: 16;">
                        <Label styleClass="sidebar-section-title" text="Profile Details" style="-fx-padding: 0; -fx-text-fill: #2D3D4F;"/>
                        <Label fx:id="profileDescriptionLabel" text="No profile selected" wrapText="true" style="-fx-text-fill: #64748B; -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Box ID -->
            <HBox spacing="20.0">
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-weight: 700;" text="Box Identifier" />
                    <TextField fx:id="boxNameTextField" promptText="e.g. Inbox-2024-001" />
                    <Label fx:id="boxNameErrorLabel" styleClass="text-error" text="" />
                </VBox>
                <VBox spacing="12.0" prefWidth="300.0" alignment="CENTER_LEFT">
                    <CheckBox fx:id="duplicateDetectionCheckBox" text="Enable Dup. Detection" style="-fx-font-weight: 600;"/>
                </VBox>
            </HBox>

            <!-- Notes -->
            <VBox spacing="8.0">
                <Label style="-fx-font-weight: 700;" text="Session Notes (Optional)" />
                <TextArea fx:id="notesTextArea" prefRowCount="3" promptText="Add context for this scan..." wrapText="true" />
            </VBox>
        </VBox>
    </content>

    <buttonTypes>
        <ButtonType fx:id="startScanButtonType" buttonData="OK_DONE" text="Initialize Session" />
        <ButtonType fx:id="cancelButtonType" buttonData="CANCEL_CLOSE" text="Cancel" />
    </buttonTypes>
</DialogPane>
