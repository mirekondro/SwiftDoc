<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="dk.easv.swiftdoc.controller.AdminController"
      prefWidth="1280.0" prefHeight="800.0"
      styleClass="app-root">

    <!-- SIDEBAR -->
    <VBox styleClass="app-sidebar" minWidth="350.0" maxWidth="350.0">
        <!-- Logo -->
        <VBox styleClass="sidebar-logo-container">
            <ImageView fx:id="brandLogo" preserveRatio="true" fitHeight="40"/>
        </VBox>

        <!-- Navigation -->
        <VBox spacing="8.0" styleClass="sidebar-nav-container" VBox.vgrow="ALWAYS">
            <Label text="Administration" styleClass="sidebar-section-title"/>
            <Button text="Profiles" onAction="#onSelectProfiles" maxWidth="Infinity" styleClass="btn btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-layer-group" iconSize="14"/></graphic>
            </Button>
            <Button text="Clients" onAction="#onSelectClients" maxWidth="Infinity" styleClass="btn btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-building" iconSize="14"/></graphic>
            </Button>
            <Button text="Users" onAction="#onSelectUsers" maxWidth="Infinity" styleClass="btn btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-users" iconSize="14"/></graphic>
            </Button>
            <Button text="System Logs" onAction="#onSelectLogs" maxWidth="Infinity" styleClass="btn btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-list-ul" iconSize="14"/></graphic>
            </Button>
        </VBox>

        <!-- Bottom -->
        <VBox spacing="8.0" styleClass="sidebar-nav-container">
            <Button text="Sign out" onAction="#onLogoutCommand" maxWidth="Infinity" styleClass="btn btn-danger">
                <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="14"/></graphic>
            </Button>
        </VBox>
    </VBox>

    <!-- WORKSPACE -->
    <VBox HBox.hgrow="ALWAYS" styleClass="app-workspace" minWidth="0.0">
        
        <!-- Top Bar -->
        <HBox alignment="CENTER_LEFT" styleClass="workspace-top-bar">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Admin Dashboard" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                <Label fx:id="welcomeLabel" text="Manage your system settings" style="-fx-text-fill: #64748B;"/>
            </VBox>
        </HBox>

        <!-- Content Area -->
        <TabPane fx:id="adminTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" style="-fx-tab-max-height: 0; -fx-tab-min-height: 0; -fx-padding: 0;">
            <tabs>
                <!-- PROFILES -->
                <Tab>
                    <fx:include fx:id="profileManagement" source="profile-management.fxml"/>
                </Tab>

                <!-- CLIENTS -->
                <Tab>
                    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="workspace-scroll">
                        <VBox spacing="32.0" styleClass="workspace-body">
                            <HBox spacing="32.0" VBox.vgrow="ALWAYS">
                                <VBox spacing="16.0" prefWidth="540.0" styleClass="viewer-container" style="-fx-padding: 24;">
                                    <Label text="Registered Clients" styleClass="sidebar-section-title" style="-fx-text-fill: #0F172A; -fx-padding: 0;"/>
                                    <ListView fx:id="clientsList" VBox.vgrow="ALWAYS" styleClass="app-tree" style="-fx-background-color: transparent;"/>
                                    <Button text="Refresh clients" onAction="#onRefreshClients" styleClass="btn">
                                        <graphic><FontIcon iconLiteral="fas-sync-alt"/></graphic>
                                    </Button>
                                </VBox>
                                <VBox spacing="16.0" HBox.hgrow="ALWAYS" styleClass="stat-card" style="-fx-padding: 32; -fx-background-color: #F8FAFC;">
                                    <Label text="Configuration Note" styleClass="sidebar-section-title" style="-fx-text-fill: #0F172A; -fx-padding: 0;"/>
                                    <Label text="Clients are managed via external integration. To register a new client, please update the main database directly (dbo.Clients table)."
                                           wrapText="true" style="-fx-text-fill: #64748B; -fx-font-size: 14px;"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- USERS -->
                <Tab>
                    <fx:include fx:id="userManagement" source="user-management.fxml"/>
                </Tab>

                <!-- LOGS -->
                <Tab>
                    <fx:include fx:id="logs" source="logs-view.fxml"/>
                </Tab>
            </tabs>
        </TabPane>
    </VBox>

</HBox>
