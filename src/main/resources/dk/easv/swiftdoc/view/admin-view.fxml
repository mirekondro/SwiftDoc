<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="dk.easv.swiftdoc.controller.AdminController"
      prefWidth="1280.0" prefHeight="800.0"
      styleClass="app-root">

    <!-- SIDEBAR -->
    <VBox styleClass="app-sidebar">
        <!-- Logo -->
        <VBox styleClass="sidebar-logo-container">
            <ImageView fx:id="brandLogo" preserveRatio="true" fitHeight="32">
                <image>
                    <Image url="@../assets/logos/LogoBlue2H.png"/>
                </image>
            </ImageView>
        </VBox>

        <!-- Navigation -->
        <VBox styleClass="sidebar-nav-container" VBox.vgrow="ALWAYS">
            <Label text="Administration" styleClass="sidebar-section-title"/>
            <Button fx:id="btnProfiles" text="Profiles" onAction="#onSelectProfiles" maxWidth="Infinity" styleClass="btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-layer-group" iconSize="16"/></graphic>
            </Button>
            <Button fx:id="btnClients" text="Clients" onAction="#onSelectClients" maxWidth="Infinity" styleClass="btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-building" iconSize="16"/></graphic>
            </Button>
            <Button fx:id="btnUsers" text="Users" onAction="#onSelectUsers" maxWidth="Infinity" styleClass="btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-users" iconSize="16"/></graphic>
            </Button>
            <Button fx:id="btnLogs" text="System Logs" onAction="#onSelectLogs" maxWidth="Infinity" styleClass="btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-list-ul" iconSize="16"/></graphic>
            </Button>
        </VBox>

        <!-- Bottom -->
        <VBox styleClass="sidebar-nav-container">
            <Button text="Sign out" onAction="#onLogoutCommand" maxWidth="Infinity" styleClass="btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="16"/></graphic>
            </Button>
        </VBox>
    </VBox>

    <!-- WORKSPACE -->
    <VBox HBox.hgrow="ALWAYS" styleClass="app-workspace" minWidth="0.0">
        
        <!-- Top Bar -->
        <HBox alignment="CENTER_LEFT" styleClass="workspace-top-bar">
            <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                <Label text="Admin Dashboard" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #1F2937; -fx-padding: 0;"/>
                <Label fx:id="welcomeLabel" text="Signed in as admin (ADMIN)" style="-fx-text-fill: #64748B; -fx-font-size: 14px; -fx-padding: 0;"/>
            </VBox>
        </HBox>

        <!-- Content Area -->
        <TabPane fx:id="adminTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" style="-fx-tab-max-height: 0; -fx-tab-min-height: 0; -fx-padding: 0;">
            <tabs>
                <!-- PROFILES -->
                <Tab>
                    <fx:include fx:id="profileManagement" source="profile-management.fxml"/>
                </Tab>

                <!-- CLIENTS -->
                <Tab>
                    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="workspace-scroll">
                        <VBox spacing="32.0" styleClass="workspace-body">
                            <HBox spacing="32.0" VBox.vgrow="ALWAYS">
                                <VBox spacing="16.0" prefWidth="540.0" styleClass="viewer-container" style="-fx-padding: 24;">
                                    <Label text="Registered Clients" styleClass="sidebar-section-title" style="-fx-text-fill: #0F172A; -fx-padding: 0;"/>
                                    <ListView fx:id="clientsList" VBox.vgrow="ALWAYS" styleClass="app-tree" style="-fx-background-color: transparent;"/>
                                    <HBox spacing="12.0">
                                        <Button text="Add" onAction="#onCreateClient" styleClass="btn-primary">
                                            <graphic><FontIcon iconLiteral="fas-plus" iconSize="14"/></graphic>
                                        </Button>
                                        <Button text="Rename" onAction="#onRenameClient" styleClass="btn-secondary">
                                            <graphic><FontIcon iconLiteral="fas-pen" iconSize="14"/></graphic>
                                        </Button>
                                        <Button text="Delete" onAction="#onDeleteClient" styleClass="btn-secondary">
                                            <graphic><FontIcon iconLiteral="fas-trash" iconSize="14"/></graphic>
                                        </Button>
                                        <Button text="Refresh" onAction="#onRefreshClients" styleClass="btn">
                                            <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="14"/></graphic>
                                        </Button>
                                    </HBox>
                                </VBox>
                                <VBox spacing="16.0" HBox.hgrow="ALWAYS" styleClass="stat-card" style="-fx-padding: 32; -fx-background-color: #F8FAFC;">
                                    <Label text="Manage Clients" styleClass="sidebar-section-title" style="-fx-text-fill: #0F172A; -fx-padding: 0;"/>
                                    <Label text="Add a new client, rename an existing one, or delete clients that have no profiles attached. Clients with profiles must be cleared first."
                                           wrapText="true" style="-fx-text-fill: #64748B; -fx-font-size: 14px;"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- USERS -->
                <Tab>
                    <fx:include fx:id="userManagement" source="user-management.fxml"/>
                </Tab>

                <!-- LOGS -->
                <Tab>
                    <fx:include fx:id="logs" source="logs-view.fxml"/>
                </Tab>
            </tabs>
        </TabPane>
    </VBox>

</HBox>
