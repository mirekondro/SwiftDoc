<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="dk.easv.swiftdoc.controller.AdminController"
      spacing="0.0"
      prefWidth="1160.0" prefHeight="720.0"
      styleClass="app-root">

    <!-- Header bar -->
    <HBox spacing="12.0" styleClass="app-header" alignment="CENTER_LEFT">
        <HBox spacing="9.0" styleClass="app-brand" alignment="CENTER_LEFT">
            <ImageView fx:id="brandLogo" styleClass="brand-logo" preserveRatio="true" fitHeight="30"/>
            <VBox spacing="2.0">
                <Label text="Admin" styleClass="app-title"/>
                <Label fx:id="welcomeLabel" text="Manage profiles, clients and users"
                       styleClass="app-subtitle"/>
            </VBox>
        </HBox>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="Log out" onAction="#onLogoutCommand" styleClass="btn btn-logout">
            <graphic><FontIcon iconLiteral="fas-sign-out-alt"/></graphic>
        </Button>
    </HBox>

    <!-- Tab content -->
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

        <!-- PROFILES -->
        <Tab text="Profiles">
            <fx:include fx:id="profileManagement" source="profile-management.fxml"/>
        </Tab>

        <!-- CLIENTS -->
        <Tab text="Clients">
            <HBox spacing="14.0" styleClass="app-body">
                <VBox spacing="10.0" prefWidth="500.0" styleClass="panel">
                    <Label text="Clients" styleClass="section-title"/>
                    <ListView fx:id="clientsList" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="8.0">
                        <Button text="Create client" onAction="#onCreateClient" styleClass="btn btn-primary">
                            <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
                        </Button>
                        <Button text="Refresh" onAction="#onRefreshClients" styleClass="btn">
                            <graphic><FontIcon iconLiteral="fas-sync-alt"/></graphic>
                        </Button>
                    </HBox>
                </VBox>
                <VBox spacing="8.0" HBox.hgrow="ALWAYS" styleClass="panel">
                    <Label text="About clients" styleClass="section-title"/>
                    <Label text="Clients group scanning profiles. Click &quot;Create client&quot; to add one, then assign it when creating a profile."
                           wrapText="true" styleClass="status-pill"/>
                </VBox>
            </HBox>
        </Tab>

        <!-- USERS -->
        <Tab text="Users">
            <fx:include fx:id="userManagement" source="user-management.fxml"/>
        </Tab>

        <!-- LOGS -->
        <Tab text="Logs">
            <fx:include fx:id="logs" source="logs-view.fxml"/>
        </Tab>

    </TabPane>
</VBox>
