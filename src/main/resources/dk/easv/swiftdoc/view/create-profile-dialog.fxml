<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<DialogPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="dk.easv.swiftdoc.controller.CreateProfileDialogController"
            fx:id="dialogPane"
            styleClass="dialog-root">
    <headerText>Create Profile</headerText>
    <contentText>Profiles bundle scanning settings for a specific client.</contentText>

    <content>
        <VBox spacing="14.0" styleClass="dialog-content">
            <VBox spacing="8.0" styleClass="dialog-card">
                <Label text="Profile Name" styleClass="section-title"/>
                <TextField fx:id="profileNameField" promptText="e.g. 'Standard municipal box'"/>
                <Label fx:id="profileNameErrorLabel" text=""
                       style="-fx-text-fill: #cc0000; -fx-font-size: 10;" wrapText="true"/>
            </VBox>

            <VBox spacing="8.0" styleClass="dialog-card">
                <Label text="Client" styleClass="section-title"/>
                <ComboBox fx:id="clientComboBox" promptText="Select a client..."
                          maxWidth="1.7976931348623157E308"/>
                <Label fx:id="clientErrorLabel" text=""
                       style="-fx-text-fill: #cc0000; -fx-font-size: 10;" wrapText="true"/>
                <Label text="One client can have many profiles."
                       styleClass="dialog-muted" wrapText="true"/>
            </VBox>

            <VBox spacing="8.0" styleClass="dialog-card">
                <Label text="Scan Options" styleClass="section-title"/>
                <CheckBox fx:id="duplicateDetectionCheckBox"
                          text="Enable duplicate detection"/>
                <Label text="When enabled, scanning detects and flags repeated pages."
                       styleClass="dialog-muted" wrapText="true"/>
            </VBox>

            <!-- NEW: image processing applied to every page at export time -->
            <VBox spacing="10.0" styleClass="dialog-card">
                <Label text="Page Processing" styleClass="section-title"/>
                <Label text="Applied to every page when this profile's box is exported. Originals are kept."
                       styleClass="dialog-muted" wrapText="true"/>

                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Label text="Rotation" styleClass="muted" minWidth="80.0"/>
                    <Spinner fx:id="rotationSpinner" editable="true" prefWidth="90.0"/>
                    <Label text="°" styleClass="muted"/>
                </HBox>

                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Label text="Brightness" styleClass="muted" minWidth="80.0"/>
                    <Slider fx:id="brightnessSlider" min="-100" max="100" value="0"
                            showTickLabels="true" showTickMarks="true"
                            majorTickUnit="50" minorTickCount="4"
                            HBox.hgrow="ALWAYS"/>
                    <Label fx:id="brightnessValueLabel" text="0" styleClass="muted" minWidth="36.0"/>
                </HBox>

                <CheckBox fx:id="blackAndWhiteCheckBox" text="Convert to black &amp; white"/>
                <Label text="Black &amp; white produces smaller files, ideal for text documents."
                       styleClass="dialog-muted" wrapText="true"/>
            </VBox>
        </VBox>
    </content>

    <buttonTypes>
        <ButtonType fx:id="createButtonType" text="Create" buttonData="OK_DONE"/>
        <ButtonType fx:id="cancelButtonType" text="Cancel" buttonData="CANCEL_CLOSE"/>
    </buttonTypes>
</DialogPane>
