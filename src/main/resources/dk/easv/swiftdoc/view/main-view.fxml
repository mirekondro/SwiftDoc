<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="dk.easv.swiftdoc.controller.MainController"
      fx:id="root"
      onKeyPressed="#onKeyPressed"
      focusTraversable="true"
      prefWidth="1280.0" prefHeight="800.0"
      styleClass="app-root">

    <!-- GLOBAL SIDEBAR -->
    <VBox styleClass="app-sidebar" minWidth="350.0" maxWidth="350.0">
        <!-- Logo -->
        <VBox styleClass="sidebar-logo-container">
            <ImageView fx:id="brandLogo" preserveRatio="true" fitHeight="32"/>
        </VBox>

        <!-- Primary Actions -->
        <VBox styleClass="sidebar-nav-container">
            <Label text="Workspace" styleClass="sidebar-section-title"/>
            <Button text="New scan (F1)" onAction="#onNewCommand" maxWidth="Infinity" styleClass="btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-plus" iconSize="16"/></graphic>
            </Button>
            <Button fx:id="scanButton" text="Scan page (F2)" onAction="#onScanCommand" disable="true" maxWidth="Infinity" styleClass="btn-sidebar-cta">
                <graphic><FontIcon iconLiteral="fas-camera" iconSize="16"/></graphic>
            </Button>
            <Button text="Export scans (F3)" onAction="#onSaveCommand" maxWidth="Infinity" styleClass="btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-file-export" iconSize="16"/></graphic>
            </Button>
            <Button fx:id="finishSessionButton" text="Finish session" onAction="#onFinishSessionCommand" visible="false" managed="false" maxWidth="Infinity" styleClass="btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-check" iconSize="16"/></graphic>
            </Button>
        </VBox>

        <!-- Navigation Tree -->
        <VBox VBox.vgrow="ALWAYS" styleClass="sidebar-nav-container">
            <Label text="Boxes &amp; History" styleClass="sidebar-section-title"/>
            <TreeView fx:id="sidebarTree" VBox.vgrow="ALWAYS" showRoot="false" styleClass="app-tree"/>
        </VBox>

        <!-- Bottom Actions -->
        <VBox styleClass="sidebar-nav-container">
            <Button text="Keyboard shortcuts (Shift+S)" onAction="#onShowShortcutsCommand" maxWidth="Infinity" styleClass="btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-keyboard" iconSize="16"/></graphic>
            </Button>
            <Button text="Sign out" onAction="#onLogoutCommand" maxWidth="Infinity" styleClass="btn-sidebar, btn-signout">
                <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="16" iconColor="#EF4444"/></graphic>
            </Button>
        </VBox>
    </VBox>

    <!-- MAIN WORKSPACE -->
    <VBox HBox.hgrow="ALWAYS" styleClass="app-workspace" minWidth="0.0">
        
        <!-- Top Bar -->
        <HBox alignment="CENTER_LEFT" styleClass="workspace-top-bar" spacing="24.0">
            <!-- Title -->
            <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                <Label text="Scanner Workspace" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #2D3D4F; -fx-padding: 0;"/>
                <Label text="Capture, organize, and export scanned documents." style="-fx-text-fill: #64748B; -fx-font-size: 14px; -fx-padding: 0;"/>
            </VBox>

            <!-- Search -->
            <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="topbar-search" maxWidth="320" HBox.hgrow="SOMETIMES">
                <FontIcon iconLiteral="fas-search" iconSize="13" style="-fx-icon-color: #BFBFBF;"/>
                <TextField fx:id="sidebarSearchField" promptText="Search boxes, barcodes, files…" HBox.hgrow="ALWAYS"/>
                <Button onAction="#onClearSidebarSearch" styleClass="topbar-search-clear">
                    <graphic><FontIcon iconLiteral="fas-times" iconSize="11"/></graphic>
                </Button>
            </HBox>

            <!-- Stats -->
            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="stat-pill">
                    <FontIcon iconLiteral="fas-clock" iconSize="13" style="-fx-icon-color: #BFBFBF;"/>
                    <Label text="Session" styleClass="stat-pill-label"/>
                    <Label fx:id="sessionInfoLabel" text="None" styleClass="stat-pill-value"/>
                </HBox>
                <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="stat-pill">
                    <FontIcon iconLiteral="fas-file-alt" iconSize="13" style="-fx-icon-color: #BFBFBF;"/>
                    <Label text="Scanned" styleClass="stat-pill-label"/>
                    <Label fx:id="counterLabel" text="0" styleClass="stat-pill-value"/>
                </HBox>
            </HBox>
        </HBox>

        <!-- Body Scroll Container -->
        <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" fitToHeight="true" styleClass="workspace-scroll">
            <VBox styleClass="workspace-body" spacing="24.0">

                <!-- Viewer Card -->
                <VBox spacing="20.0" VBox.vgrow="ALWAYS" styleClass="viewer-container">

                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT" spacing="16.0">
                        <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                            <Label fx:id="viewerCaptionLabel" text="No file selected" styleClass="section-title"/>
                            <Label fx:id="lastResultLabel" text="Select a file from the sidebar to start viewing." style="-fx-text-fill: #64748B; -fx-font-size: 14px;"/>
                        </VBox>
                        <Button text="Delete file (Del)" onAction="#onDeleteFileCommand" styleClass="btn-secondary">
                            <graphic><FontIcon iconLiteral="fas-trash-alt" iconSize="14"/></graphic>
                        </Button>
                    </HBox>

                    <!-- Viewer -->
                    <ScrollPane fx:id="viewerScrollPane" VBox.vgrow="ALWAYS"
                                pannable="true" fitToWidth="false" fitToHeight="false"
                                styleClass="viewer-scroll">
                        <StackPane fx:id="viewerStack" alignment="CENTER"
                                   style="-fx-background-color: transparent;">
                            <ImageView fx:id="pageImageView"
                                       preserveRatio="true"
                                       smooth="true"/>
                        </StackPane>
                    </ScrollPane>
                </VBox>
            </VBox>
        </ScrollPane>

        <!-- Fixed Toolbar — always visible at bottom -->
        <HBox alignment="CENTER" spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-padding: 12 0; -fx-border-color: #E2E4E8; -fx-border-width: 1 0 0 0;">
            <HBox alignment="CENTER" spacing="6.0" styleClass="viewer-toolbar">
                <Button onAction="#onZoomOutCommand" styleClass="btn-icon">
                    <graphic><FontIcon iconLiteral="fas-search-minus" iconSize="14"/></graphic>
                </Button>
                <Button onAction="#onResetZoomCommand" styleClass="btn-icon">
                    <graphic><FontIcon iconLiteral="fas-expand" iconSize="14"/></graphic>
                </Button>
                <Button onAction="#onZoomInCommand" styleClass="btn-icon">
                    <graphic><FontIcon iconLiteral="fas-search-plus" iconSize="14"/></graphic>
                </Button>
                <Separator orientation="VERTICAL" prefHeight="20"/>
                <Button text="Reset (Ctrl+R)" onAction="#onResetRotationCommand" styleClass="btn-secondary"/>
                <Button text="Rotate (Ctrl+T)" onAction="#onCustomRotationCommand" styleClass="btn-secondary"/>
            </HBox>
        </HBox>
    </VBox>

</HBox>
