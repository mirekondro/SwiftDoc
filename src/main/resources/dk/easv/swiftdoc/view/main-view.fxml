<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="dk.easv.swiftdoc.controller.MainController"
      fx:id="root"
      onKeyPressed="#onKeyPressed"
      focusTraversable="true"
      spacing="0.0"
      prefWidth="1180.0" prefHeight="740.0"
      styleClass="app-root">

    <!-- Top menu bar -->
    <MenuBar styleClass="app-menubar">
        <Menu text="Export">
            <MenuItem text="Export…" onAction="#onExportMenuCommand"/>
        </Menu>
    </MenuBar>

    <!-- Header bar -->
    <HBox spacing="12.0" styleClass="app-header" alignment="CENTER_LEFT">
        <!-- Brand -->
        <HBox spacing="10.0" styleClass="app-brand" alignment="CENTER_LEFT">
            <FontIcon iconLiteral="fas-bolt" iconSize="22" styleClass="brand-icon"/>
            <VBox spacing="2.0">
                <Label text="SwiftDoc" styleClass="app-title"/>
                <Label text="Scan. Organize. Export." styleClass="app-subtitle"/>
            </VBox>
        </HBox>

        <!-- Right side stat cards + controls -->
        <HBox spacing="8.0" styleClass="header-cards" HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
            <VBox spacing="2.0" styleClass="header-card header-card-session">
                <Label text="SESSION" styleClass="header-card-title"/>
                <Label fx:id="sessionInfoLabel" text="No active session" wrapText="true"
                       styleClass="header-card-value"/>
            </VBox>
            <VBox spacing="2.0" styleClass="header-card">
                <Label text="FILES" styleClass="header-card-title"/>
                <Label fx:id="counterLabel" text="0 scanned" styleClass="header-card-value"/>
            </VBox>
            <ToggleButton fx:id="themeToggle" text="Dark" onAction="#onThemeToggle"
                          styleClass="toggle">
                <tooltip><Tooltip text="Toggle dark/light theme"/></tooltip>
            </ToggleButton>
            <Button text="Log out" onAction="#onLogoutCommand" styleClass="btn btn-logout">
                <graphic><FontIcon iconLiteral="fas-sign-out-alt"/></graphic>
            </Button>
        </HBox>
    </HBox>

    <!-- Main body -->
    <HBox spacing="14.0" VBox.vgrow="ALWAYS" styleClass="app-body">

        <!-- LEFT — actions + status -->
        <VBox alignment="TOP_CENTER" spacing="10.0" prefWidth="220.0" styleClass="panel panel-left">

            <!-- Action buttons -->
            <VBox spacing="6.0" styleClass="card">
                <Button text="New scan  F1" onAction="#onNewCommand"
                        maxWidth="Infinity" styleClass="btn">
                    <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
                </Button>
                <Button text="Save  Ctrl+S" onAction="#onSaveCommand"
                        maxWidth="Infinity" styleClass="btn btn-accent">
                    <graphic><FontIcon iconLiteral="fas-save"/></graphic>
                </Button>
                <Button fx:id="scanButton" text="Scan  F2" onAction="#onScanCommand"
                        disable="true" maxWidth="Infinity" styleClass="btn btn-primary">
                    <graphic><FontIcon iconLiteral="fas-camera"/></graphic>
                </Button>
                <Button fx:id="finishSessionButton" text="Finish session"
                        onAction="#onFinishSessionCommand"
                        visible="false" managed="false"
                        maxWidth="Infinity" styleClass="btn">
                    <graphic><FontIcon iconLiteral="fas-check"/></graphic>
                </Button>
            </VBox>

            <!-- Status -->
            <VBox spacing="6.0" styleClass="card">
                <Label text="Status" styleClass="section-title"/>
                <Label fx:id="lastResultLabel" text="—" wrapText="true" styleClass="status-pill"/>
            </VBox>

            <!-- Shortcuts -->
            <VBox spacing="6.0" styleClass="card">
                <Button text="Keyboard shortcuts" onAction="#onShowShortcutsCommand"
                        maxWidth="Infinity" styleClass="btn">
                    <graphic><FontIcon iconLiteral="fas-keyboard"/></graphic>
                </Button>
            </VBox>
        </VBox>

        <!-- MIDDLE — sidebar tree -->
        <VBox spacing="8.0" prefWidth="290.0" styleClass="panel panel-sidebar">
            <HBox alignment="CENTER_LEFT" spacing="6.0">
                <Label text="All boxes" styleClass="section-title"/>
                <Label text="History" styleClass="pill pill-info"/>
            </HBox>

            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <TextField fx:id="sidebarSearchField"
                           promptText="Search boxes, barcodes, files…"
                           HBox.hgrow="ALWAYS"/>
                <Button onAction="#onClearSidebarSearch" styleClass="btn">
                    <graphic><FontIcon iconLiteral="fas-times"/></graphic>
                    <tooltip><Tooltip text="Clear search"/></tooltip>
                </Button>
            </HBox>

            <TreeView fx:id="sidebarTree" VBox.vgrow="ALWAYS" showRoot="false"
                      styleClass="app-tree"/>
        </VBox>

        <!-- RIGHT — image viewer -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="panel panel-viewer">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label fx:id="viewerCaptionLabel" text="No page to display yet"
                       styleClass="viewer-title"/>
                <Label text="Preview" styleClass="pill pill-accent"/>
            </HBox>

            <!-- Toolbar -->
            <HBox spacing="6.0" styleClass="toolbar">
                <Button text="Delete" onAction="#onDeleteFileCommand" styleClass="btn btn-logout">
                    <graphic><FontIcon iconLiteral="fas-trash-alt"/></graphic>
                    <tooltip><Tooltip text="Delete current file"/></tooltip>
                </Button>
                <Button text="Rotate  Ctrl+T" onAction="#onCustomRotationCommand" styleClass="btn">
                    <graphic><FontIcon iconLiteral="fas-redo"/></graphic>
                    <tooltip><Tooltip text="Custom rotation angle"/></tooltip>
                </Button>
                <Button text="Reset  Ctrl+0" onAction="#onResetRotationCommand" styleClass="btn">
                    <graphic><FontIcon iconLiteral="fas-undo"/></graphic>
                    <tooltip><Tooltip text="Reset rotation"/></tooltip>
                </Button>
                <Button text="Zoom in  Ctrl++" onAction="#onZoomInCommand" styleClass="btn">
                    <graphic><FontIcon iconLiteral="fas-search-plus"/></graphic>
                </Button>
                <Button text="Zoom out  Ctrl+-" onAction="#onZoomOutCommand" styleClass="btn">
                    <graphic><FontIcon iconLiteral="fas-search-minus"/></graphic>
                </Button>
                <Button text="Fit  Ctrl+1" onAction="#onResetZoomCommand" styleClass="btn">
                    <graphic><FontIcon iconLiteral="fas-expand"/></graphic>
                    <tooltip><Tooltip text="Fit page to viewer"/></tooltip>
                </Button>
            </HBox>

            <!-- Image area -->
            <StackPane VBox.vgrow="ALWAYS" styleClass="viewer-surface">
                <ImageView fx:id="pageImageView"
                           preserveRatio="true"
                           pickOnBounds="true"
                           smooth="true"
                           fitWidth="500.0"
                           fitHeight="540.0"/>
            </StackPane>
        </VBox>

    </HBox>
</VBox>
