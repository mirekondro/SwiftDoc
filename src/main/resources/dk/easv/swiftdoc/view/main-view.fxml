<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="dk.easv.swiftdoc.controller.MainController"
      fx:id="root"
      onKeyPressed="#onKeyPressed"
      focusTraversable="true"
      prefWidth="1280.0" prefHeight="800.0"
      styleClass="app-root">

    <!-- GLOBAL SIDEBAR -->
    <VBox styleClass="app-sidebar" minWidth="350.0" maxWidth="350.0">
        <!-- Logo -->
        <VBox styleClass="sidebar-logo-container">
            <ImageView fx:id="brandLogo" preserveRatio="true" fitHeight="40"/>
        </VBox>

        <!-- Primary Actions -->
        <VBox spacing="12.0" styleClass="sidebar-nav-container">
            <Label text="Workspace" styleClass="sidebar-section-title"/>
            <Button text="New scan" onAction="#onNewCommand" maxWidth="Infinity" styleClass="btn btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-plus" iconSize="14"/></graphic>
            </Button>
            <Button fx:id="scanButton" text="Scan page" onAction="#onScanCommand" disable="true" maxWidth="Infinity" styleClass="btn btn-primary">
                <graphic><FontIcon iconLiteral="fas-camera" iconSize="14"/></graphic>
            </Button>
            <Button text="Export scans" onAction="#onSaveCommand" maxWidth="Infinity" styleClass="btn btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-file-export" iconSize="14"/></graphic>
            </Button>
            <Button fx:id="finishSessionButton" text="Finish session" onAction="#onFinishSessionCommand" visible="false" managed="false" maxWidth="Infinity" styleClass="btn btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-check" iconSize="14"/></graphic>
            </Button>
        </VBox>

        <!-- Navigation Tree -->
        <VBox VBox.vgrow="ALWAYS" spacing="12.0" styleClass="sidebar-nav-container">
            <Label text="Boxes &amp; History" styleClass="sidebar-section-title"/>
            <TreeView fx:id="sidebarTree" VBox.vgrow="ALWAYS" showRoot="false" styleClass="app-tree"/>
        </VBox>

        <!-- Bottom Actions -->
        <VBox spacing="8.0" styleClass="sidebar-nav-container">
            <Button text="Keyboard shortcuts" onAction="#onShowShortcutsCommand" maxWidth="Infinity" styleClass="btn btn-sidebar">
                <graphic><FontIcon iconLiteral="fas-keyboard" iconSize="14"/></graphic>
            </Button>
            <Button text="Sign out" onAction="#onLogoutCommand" maxWidth="Infinity" styleClass="btn btn-danger">
                <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="14"/></graphic>
            </Button>
        </VBox>
    </VBox>

    <!-- MAIN WORKSPACE -->
    <VBox HBox.hgrow="ALWAYS" styleClass="app-workspace" minWidth="0.0">
        
        <!-- Top Bar -->
        <HBox alignment="CENTER_LEFT" styleClass="workspace-top-bar">
            <!-- Search -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS">
                <FontIcon iconLiteral="fas-search" iconSize="16" iconColor="#64748B"/>
                <TextField fx:id="sidebarSearchField" promptText="Search boxes, barcodes, files..." HBox.hgrow="ALWAYS" maxWidth="400"/>
                <Button onAction="#onClearSidebarSearch" styleClass="btn" style="-fx-padding: 8;">
                    <graphic><FontIcon iconLiteral="fas-times" iconSize="12"/></graphic>
                </Button>
            </HBox>

            <!-- Stats & Theme -->
            <HBox spacing="16.0" alignment="CENTER_RIGHT">
                <VBox styleClass="stat-card">
                    <Label text="Active Session" styleClass="stat-label"/>
                    <Label fx:id="sessionInfoLabel" text="No active session" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card">
                    <Label text="Scanned" styleClass="stat-label"/>
                    <Label fx:id="counterLabel" text="0 pages" styleClass="stat-value"/>
                </VBox>
            </HBox>
        </HBox>

        <!-- Body Scroll Container -->
        <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" fitToHeight="true" styleClass="workspace-scroll">
            <VBox styleClass="workspace-body" spacing="24.0">
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label fx:id="viewerCaptionLabel" text="No file selected" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                        <Label fx:id="lastResultLabel" text="Select a file from the sidebar to start viewing." style="-fx-text-fill: #64748B;"/>
                    </VBox>
                    <HBox spacing="8.0" alignment="CENTER_RIGHT">
                        <Button text="Delete file" onAction="#onDeleteFileCommand" styleClass="btn btn-danger">
                            <graphic><FontIcon iconLiteral="fas-trash-alt"/></graphic>
                        </Button>
                    </HBox>
                </HBox>

                <!-- Viewer -->
                <ScrollPane fx:id="viewerScrollPane" VBox.vgrow="ALWAYS"
                            pannable="true" fitToWidth="false" fitToHeight="false"
                            styleClass="viewer-container viewer-scroll">
                    <StackPane fx:id="viewerStack" alignment="CENTER"
                               style="-fx-background-color: transparent;">
                        <ImageView fx:id="pageImageView"
                                   preserveRatio="true"
                                   smooth="true"/>
                    </StackPane>
                </ScrollPane>
            </VBox>
        </ScrollPane>

        <!-- Fixed Toolbar — always visible at bottom -->
        <HBox alignment="CENTER" spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-padding: 12 0; -fx-border-color: #F1F5F9; -fx-border-width: 1 0 0 0;">
            <HBox alignment="CENTER" styleClass="viewer-toolbar" minWidth="400" maxWidth="400">
                <Button onAction="#onZoomOutCommand" styleClass="btn" style="-fx-padding: 8;">
                    <graphic><FontIcon iconLiteral="fas-search-minus" iconSize="16"/></graphic>
                </Button>
                <Button onAction="#onResetZoomCommand" styleClass="btn" style="-fx-padding: 8;">
                    <graphic><FontIcon iconLiteral="fas-expand" iconSize="16"/></graphic>
                </Button>
                <Button onAction="#onZoomInCommand" styleClass="btn" style="-fx-padding: 8;">
                    <graphic><FontIcon iconLiteral="fas-search-plus" iconSize="16"/></graphic>
                </Button>
                <Separator orientation="VERTICAL" prefHeight="20"/>
                <Button onAction="#onResetRotationCommand" styleClass="btn" style="-fx-padding: 8;">
                    <graphic><FontIcon iconLiteral="fas-undo" iconSize="16"/></graphic>
                </Button>
                <Button onAction="#onCustomRotationCommand" styleClass="btn" style="-fx-padding: 8;">
                    <graphic><FontIcon iconLiteral="fas-redo" iconSize="16"/></graphic>
                </Button>
            </HBox>
        </HBox>
    </VBox>

</HBox>
