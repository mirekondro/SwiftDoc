<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="dk.easv.swiftdoc.controller.LoginController"
           onKeyPressed="#onKeyPressed"
           prefWidth="460.0" prefHeight="600.0"
           styleClass="login-root">

    <VBox spacing="0.0" maxWidth="380.0" alignment="TOP_CENTER"
          styleClass="login-card" StackPane.alignment="CENTER">

        <!-- Header: WebLager logo + subtitle -->
        <VBox spacing="14.0" alignment="CENTER" styleClass="login-header">
            <ImageView fx:id="loginLogo" styleClass="login-logo" preserveRatio="true" fitHeight="120"/>
            <VBox spacing="4.0" alignment="CENTER">
                <Label text="Welcome back" styleClass="login-title"/>
                <Label text="Sign in to continue" styleClass="login-subtitle"/>
            </VBox>
        </VBox>

        <!-- Form -->
        <VBox spacing="14.0" styleClass="login-form">
            <VBox spacing="6.0">
                <Label text="Username" styleClass="login-label"/>
                <TextField fx:id="usernameField" promptText="Enter your username"/>
            </VBox>
            <VBox spacing="6.0">
                <Label text="Password" styleClass="login-label"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"/>
            </VBox>
            <Label fx:id="errorLabel" text="" wrapText="true" styleClass="login-error"/>
        </VBox>

        <!-- Actions: primary full-width + text-link cancel -->
        <VBox spacing="4.0" alignment="CENTER" styleClass="login-actions">
            <Button text="Sign in" onAction="#onLogin" defaultButton="true"
                    maxWidth="Infinity" styleClass="btn btn-primary login-primary"/>
            <Button text="Cancel" onAction="#onCancel" styleClass="btn-link"/>
        </VBox>

    </VBox>

</StackPane>
